{
  "name": "createwebs",
  "version": "1.0.0",
  "private": true,
  "description": "Portafolio de José Manuel Sánchez: sitio Astro bilingüe (ES/EN) con cuatro demos de sector interactivas.",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "node --test \"tests/unit/*.test.mjs\"",
    "test:build": "node --test \"tests/build/*.test.mjs\"",
    "verify": "npm run check && npm test && npm run build && npm run test:build"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.3.0",
    "@fontsource/fraunces": "^5.3.0",
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "astro": "^7.3.2",
    "lenis": "^1.3.26"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@types/node": "^22.20.2",
    "typescript": "^6.0.3"
  }
}
