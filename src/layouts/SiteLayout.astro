---
/* Marco común: el sitio vive dentro de un escenario fijo (#stage) con su propio
   scroll (#scroller), para que cabecera, menú, HUD y grano queden quietos.
   En la primera página de la sesión, la pantalla de carga lo cubre al entrar. */
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/500.css';
import '@fontsource/ibm-plex-sans/600.css';
import '@fontsource/ibm-plex-sans/700.css';
import '@fontsource/ibm-plex-mono/400.css';
import '@fontsource/ibm-plex-mono/500.css';
import '../styles/global.css';
import SeoHead from '../components/SeoHead.astro';
import Header from '../components/Header.astro';
import Intro from '../components/Intro.astro';
import MobileMenu from '../components/MobileMenu.astro';
import DemoBar from '../components/DemoBar.astro';
import type { Lang, PageKey } from '../lib/routes';

interface Props {
  lang: Lang;
  page: PageKey | 'demo';
  sector?: string;
}

const { lang, page, sector = '' } = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <SeoHead lang={lang} page={page} sector={sector} />
    <script is:inline src="/scripts/early.js"></script>
    <noscript><style>.stage.is-booting .page,.stage.is-booting .hdr{opacity:1;animation:none}.intro{display:none}</style></noscript>
  </head>
  <body>
    {page !== 'demo' && <Intro lang={lang} />}
    <div class="vp" id="vp">
      <div class="vp-box" id="box">
        <div class="stage is-booting" id="stage">
          <canvas id="grid" aria-hidden="true"></canvas>
          <div class="scroller" id="scroller">
            <div class="site" id="site">
              <main class="page" id="page" tabindex="-1"><slot /></main>
            </div>
          </div>
          {
            page === 'demo' ? (
              <header class="hdr is-demo" id="hdr"><DemoBar lang={lang} sector={sector} /></header>
            ) : (
              <header class="hdr" id="hdr"><Header lang={lang} page={page} /></header>
            )
          }
          <div class="menu" id="menu" hidden>{page !== 'demo' && <MobileMenu lang={lang} page={page} />}</div>
          <div class="grain" aria-hidden="true"></div>
        </div>
      </div>
    </div>
    <script>
      import { boot } from '../scripts/app.js';
      boot();
    </script>
  </body>
</html>
