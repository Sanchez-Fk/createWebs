---
/* Las cinco páginas del portafolio en los dos idiomas:
   /es/ /es/proyectos/ /es/servicios/ /es/contacto/ /es/privacidad/
   /en/ /en/work/      /en/services/  /en/contact/  /en/privacy/ */
import type { GetStaticPaths } from 'astro';
import SiteLayout from '../../layouts/SiteLayout.astro';
import Contact from '../../views/Contact.astro';
import Home from '../../views/Home.astro';
import Services from '../../views/Services.astro';
import Privacy from '../../views/Privacy.astro';
import Work from '../../views/Work.astro';
import { ROUTES } from '../../data/content';
import { ALL_PAGE_KEYS, LANGS, type Lang, type PageKey } from '../../lib/routes';

export const getStaticPaths = (() =>
  LANGS.flatMap((lang) =>
    ALL_PAGE_KEYS.map((page) => ({
      params: { lang, slug: ROUTES[lang][page] || undefined },
      props: { page },
    })),
  )) satisfies GetStaticPaths;

const lang = Astro.params.lang as Lang;
const page = Astro.props.page as PageKey;
const View = { home: Home, work: Work, services: Services, contact: Contact, privacy: Privacy }[page];
---

<SiteLayout lang={lang} page={page}>
  <View lang={lang} />
</SiteLayout>
