---
import { SERVICES } from '../data/content';
import { type Lang, type PageKey, href } from '../lib/routes';

interface Props {
  lang: Lang;
  /* adónde lleva cada fila: la página de servicios o la de contacto */
  target: PageKey;
}

const { lang, target } = Astro.props;
---

<ol class="svc">
  {
    SERVICES[lang].map(([name, desc], i) => (
      <li data-rv="row"><a class="row" href={href(lang, target)}><span class="num">0{i + 1}</span><span class="name">{name}</span><p class="desc">{desc}</p><span class="arw" aria-hidden="true">→</span></a></li>
    ))
  }
</ol>
